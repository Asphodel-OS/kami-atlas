rice tracks the marketplace: 110% of the cheapest active listing      (vendor's own excluded), clamped below by minPrice. A cheap listing is      itself a real buyable offer, so faking one risks selling at that price;      residual list/cancel timing games are bounded by the clamp \u2014 worst case      the vendor sells at the admin-set floor, one kami per <24h-old account.      The vendor holds kamis staked in-game. Admin sets a pool of kami      indices; the first 3 are displayed for sale. When one is bought, the      next from the pool fills in.", "args": "uint32 kamiIndex", "writes": ["HasFlag", "IDOwnsKami", "TimeLast", "Value", "Values"], "reads": ["EntityType", "IDOwnsKamiOrder", "State", "TimeEnd", "TimeStart"], "events": ["NEWBIE_VENDOR_BUY"], "config": ["KAMI_MARKET_FEE_RECIPIENT", "NEWBIE_VENDOR_ADDRESS", "NEWBIE_VENDOR_CYCLE", "NEWBIE_VENDOR_ENABLED", "NEWBIE_VENDOR_MIN_PRICE"], "deployed": true}, "Pool": {"comment": "PoolSystem holds all player-facing interactions with constant-product Pools: swapping and adding/removing liquidity. Liquidity removal deliberately works on disabled pools so LPs can always exit", "args": "bytes arguments", "writes": ["EntityType", "IDOwnsInventory", "IDType", "IdHolder", "IndexItem", "TimeLast", "Value"], "reads": ["CacheOperator", "HasFlag", "IsDisabled", "Rate"], "events": ["POOL_SWAP", "POOL_SYNC"], "deployed": true}, "QuestAccept": {"args": "uint32 index", "writes": ["EntityType", "IDAnchor", "IDOwnsQuest", "IndexQuest", "IsComplete", "TimeLast", "TimeStart", "Value"], "reads": ["CacheOperator", "For", "HasFlag", "IDOwnsKami", "IdSource", "Index", "IndexRoom", "IsDisabled", "Level", "LogicType", "SkillPoint", "State", "Time", "TimeNext", "Type"], "deployed": true}, "QuestComplete": {"args": "uint256 id", "writes": ["BlockReveal", "EntityType", "Experience", "HasFlag", "IDAnchor", "IDOwnsInventory", "IDType", "IdHolder", "IdSource", "IndexItem", "IndexRoom", "IsComplete", "Level", "ProxyVIPScore", "State", "Time", "Time