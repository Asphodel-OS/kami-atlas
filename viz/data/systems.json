dSource", "IndexItem", "IndexRoom", "IsComplete", "Level", "ProxyVIPScore", "State", "Time", "TimeLast", "TimeNext", "Type", "Value"], "reads": ["CacheOperator", "IDOwnsKami", "Index", "IsDisabled", "Subtype", "TokenAddress"], "config": ["VIP_SCORE_ADDRESS", "VIP_STAGE"], "deployed": true}, "GoalContribute": {"args": "uint32 goalIndex, uint256 amt", "writes": ["EntityType", "IDOwnsInventory", "IDType", "IdHolder", "IndexItem", "IsComplete", "TimeLast", "Value"], "reads": ["CacheOperator", "For", "HasFlag", "IDAnchor", "IDOwnsKami", "IdSource", "Index", "IndexRoom", "IsDisabled", "Level", "LogicType", "SkillPoint", "State", "TimeNext", "Type"], "events": ["GOAL_COMPLETE"], "deployed": true}, "HarvestCollect": {"comment": "HarvestCollectSystem collects on an active pet harvest.", "args": "uint256 id", "writes": ["EntityType", "Experience", "Health", "IDAnchor", "IDOwnsInventory", "IDType", "IdHolder", "IdSource", "IndexItem", "Level", "Time", "TimeLast", "TimeNext", "Value"], "reads": ["Affinity", "CacheOperator", "IDOwnsKami", "IDOwnsTax", "IdTarget", "IndexNode", "IndexRoom", "IsRegistry", "State", "TimeReset", "TokenAddress"], "events": ["HARVEST_COLLECT"], "config": ["KAMI_HARV_BOUNTY", "KAMI_HARV_FERTILITY", "KAMI_HARV_INTENSITY", "KAMI_HARV_STRAIN", "KAMI_REST_METABOLISM", "KAMI_STANDARD_COOLDOWN", "SCORE_EPOCH"], "deployed": true}, "HarvestLiquidate": {"comment": "liquidates a target harvest using a player's pet.", "args": "uint256 victimHarvID, uint256 killerID", "writes": ["EntityType", "Experience", "Health", "IDAnchor", "IDOwnsInventory", "IDType", "IdHolder", "IdSource", "IndexItem", "Level", "State", "Time", "TimeLast", "TimeNext", "Value"], "reads": ["Affinity", "CacheOperator", "IDOwnsKami", "IndexAccount", "IndexNode", "IndexRoom", "TimeReset", "TokenAddress"], "events": ["KILL"], "config": ["KAMI_HARV_BOUNTY", "KAMI_HARV_FERTILITY", "KAMI_HARV_INTENSITY", "KAMI_HARV_STRAIN", "KAMI_LIQ_ANIMOSITY", "KAMI_LIQ_KARMA", "KAMI_LIQ_RECOIL", "KAMI_LIQ_SALVAGE", "KAMI_LIQ_SPOILS", "KAMI_LIQ_THRESHOLD", "KAMI_REST_METABOLISM", "KAMI_STANDARD_COOLDOWN", "SCORE_EPOCH"], "deployed": true}, "HarvestStart": {"comment": "HarvestStartSystem activates a pet harvest on a node. If it doesn't exist, we create one. We limit to one harvest per pet, and one harvest on a node per character. NOTE: pet is guaranteed to be healthy if resting. TODO: update harvests to support all kinds of nodes, not just harvesting", "args": "uint256 kamiID, uint32 nodeIndex, uint256 taxerID, uint256 taxAmt", "writes": ["EntityType", "Health", "IDAnchor", "IDOwnsTax", "IDType", "IdHolder", "IdSource", "IdTarget", "Level", "State", "Time", "TimeLast", "TimeNext", "TimeReset", "TimeStart", "Value"], "reads": ["Affinity", "CacheOperator", "For", "HasFlag", "IDOwnsKami", "Index", "IndexRoom", "IsComplete", "LogicType", "SkillPoint", "Subtype", "Type"], "config": ["KAMI_HARV_BOUNTY", "KAMI_HARV_FERTILITY", "KAMI_HARV_INTENSITY", "KAMI_HARV_STRAIN", "KAMI_REST_METABOLISM", "KAMI_STANDARD_COOLDOWN"], "deployed": true}, "HarvestStop": {"comment": "HarvestStopSystem collects and stops an active pet harvest. This is the case when a pet is stopped by the owner. When it is stopped by liquidation or death, the output is not collected. TODO: update harvests to support all kinds of nodes, not just harvesting", "args": "uint256 id", "writes": ["EntityType", "Experience", "Health", "IDAnchor", "IDOwnsInventory", "IDType", "IdHolder", "IdSource", "IndexItem", "Level", "State", "Time", "TimeLast", "TimeNext", "Value"], "reads": ["Affinity", "CacheOperator", "IDOwnsKami", "IDOwnsTax", "IdTarget", "IndexNode", "IndexRoom", "IsRegistry", "TimeReset", "TimeStart", "TokenAddress"], "events": ["HARVEST_STOP"], "config": ["KAMI_HARV_BOUNTY", "KAMI_HARV_FERTILITY", "KAMI_HARV_INTENSITY", "KAMI_HARV_STRAIN", "KAMI_REST_METABOLISM", "KAMI_STANDARD_COOLDOWN", "SCORE_EPOCH"], "deployed": true}, "ItemBurn": {"comment": "@notice a system that burns items from inventory - burnt items are lost forever, with no use effects @dev used for quest ITEM_GIVE stuffs", "args": "uint32[] indices, uint256[] amts", "writes": ["EntityType", "IDOwnsInventory", "IndexItem", "TimeLast", "Value"], "reads": ["CacheOperator", "HasFlag"], "deployed": true}, "ItemTransfer": {"args": "uint32[] indices, uint256[] amts, uint256 targetID", "writes": ["EntityType", "IDOwnsInventory", "IndexItem", "TimeLast", "Value"], "reads": ["HasFlag"], "events": ["ITEM_TRANSFER"], "deployed": true}, "Kami721IsInWorld": {"comment": "@notice a view check to check if pet is in world. Used to allow upgradibiliy", "reads": ["EntityType", "State"], "deployed": true}, "Kami721Metadata": {"comment": "@title  System that handles metadata for Kami721 @dev    does not implement execute, only views tokenURI @dev    URI is structured in a system to allow for upgradibility", "reads": ["Affinity", "EntityType", "Level", "MediaURI", "Name", "Stat[by name]", "Value"], "config": ["BASE_URI"], "deployed": true}, "Kami721Stake": {"comment": "@dev Room 12 is the bridge room, system can only be called there  Invariants:    Before deposit:      1) Pet does not have an Account, owned by EOA      2) Pet state is \"721_EXTERNAL\"    After deposit:      1) Pet is linked to Account owned by msg.sender, token owned by Kami721      2) Pet state is not \"721_EXTERNAL\"", "args": "uint32 tokenIndex", "writes": ["Balance", "IDOwnsKami", "IDOwnsKamiOrder", "IndexKami", "IndexKamiListing", "Max", "State", "TimeEnd", "TimeLast", "TimeStart", "Value", "Values"], "reads": ["EntityType", "IndexRoom"], "events": ["KAMI_MARKET_CANCEL"], "config": ["KAMI721_ADDRESS"], "deployed": true, "writes_without_access": ["IndexKami"], "writes_without_access_paths": {"IndexKami": ["Kami721StakeSystem.execute", "LibKamiMarket.cancelListingsForKami", "LibKamiMarket.cancelListing", "LibKamiMarket._markCancelled", "LibKamiMarket._cleanup", "LibKamiMarketIndex.cleanup"]}}, "Kami721Transfer": {"comment": "@dev Simple system to enable kami batch transfers. Handles 721 contract only, does not interact with components.", "args": "bytes arguments", "reads": ["Value"], "config": ["KAMI721_ADDRESS"], "deployed": true}, "Kami721Unstake": {"comment": "@dev Room 12 is the bridge room, system can only be called there  Invarients:    Before withdrawal:      1) Pet is linked to an Account owned by address, token owned by Kami721      2) Pet state is not \"721_EXTERNAL\" + Pet stats is \"RESTING\"      3) Pet is revealed    After withdrawal:      1) Pet is not linked to an Account, owned by EOA      2) Pet state is \"721_EXTERNAL\"", "args": "uint32 tokenIndex", "writes": ["EntityType", "For", "IDAnchor", "IDOwnsEquipment", "IDOwnsInventory", "IDOwnsKami", "IDType", "IdSource", "IndexItem", "Level", "State", "Time", "TimeLast", "Value"], "reads": ["IndexRoom", "TokenAddress"], "config": ["KAMI721_ADDRESS"], "deployed": true}, "KamiCastItem": {"comment": "cast an item on an enemy kami", "args": "uint256 targetID, uint32 itemIndex", "writes": ["BlockReveal", "EntityType", "Experience", "HasFlag", "Health", "IDAnchor", "IDOwnsInventory", "IDType", "IdHolder", "IdSource", "IndexItem", "IndexRoom", "Level", "ProxyVIPScore", "Stamina", "State", "Time", "TimeLast", "TimeLastAction", "TimeNext", "Type", "Value"], "reads": ["Affinity", "CacheOperator", "For", "IDOwnsKami", "Index", "IndexNode", "IsComplete", "IsDisabled", "LogicType", "SkillPoint", "Subtype", "TimeReset", "TokenAddress"], "events": ["KAMI_CAST"], "config": ["ACCOUNT_STAMINA", "KAMI_HARV_BOUNTY", "KAMI_HARV_FERTILITY", "KAMI_HARV_INTENSITY", "KAMI_HARV_STRAIN", "KAMI_REST_METABOLISM", "VIP_SCORE_ADDRESS", "VIP_STAGE"], "deployed": true}, "KamiEquip": {"comment": "@notice System for equipping items to kamis @dev Equipment items use slot-based equipping with bonuses that persist until unequipped", "args": "uint256 kamiID, uint32 itemIndex", "writes": ["EntityType", "For", "IDAnchor", "IDOwnsEquipment", "IDOwnsInventory", "IDType", "IdSource", "IndexItem", "Level", "Time", "TimeLast", "Value"], "reads": ["CacheOperator", "IDOwnsKami", "IsDisabled", "State", "Subtype", "TokenAddress", "Type"], "deployed": true}, "KamiGachaMint": {"comment": "@notice commits to get a random pet from gacha using a Gacha Ticket @dev this acts as a replacement for a traditional reveal", "args": "uint256 amount", "writes": ["BlockReveal", "EntityType", "Experience", "Harmony", "Health", "IDOwnsInventory", "IDOwnsKami", "IdHolder", "IndexItem", "IndexKami", "Level", "MediaURI", "Name", "Power", "SkillPoint", "Slots", "State", "TimeLast", "Type", "Value", "Violence"], "reads": ["Rarity"], "config": ["BASE_KAMI_NAME", "KAMI721_ADDRESS"], "deployed": true}, "KamiGachaReroll": {"comment": "@notice commits to get a random pet from gacha via rerolling + cost @dev only meant to be called for a single account", "args": "bytes arguments", "writes": ["BlockReveal", "EntityType", "For", "IDAnchor", "IDOwnsEquipment", "IDOwnsInventory", "IDOwnsKami", "IDType", "IdHolder", "IdSource", "IndexItem", "Level", "Reroll", "Time", "TimeLast", "Type", "Value"], "reads": ["State", "TokenAddress"], "deployed": true}, "KamiGachaReveal": {"comment": "@notice reveals gacha results. owner agnostic - reveal is sent to original account", "args": "bytes arguments", "writes": ["BlockReveal", "IDOwnsKami", "IdHolder", "Reroll", "Type", "Value"], "deployed": true}, "KamiLevel": {"comment": "level a pet up", "args": "uint256 id", "writes": ["Experience", "Health", "Level", "SkillPoint", "TimeLast", "Value"], "reads": ["Affinity", "CacheOperator", "EntityType", "IDOwnsKami", "IDType", "IdHolder", "IdSource", "IndexKami", "State", "TimeReset"], "config": ["KAMI721_ADDRESS", "KAMI_HARV_BOUNTY", "KAMI_HARV_FERTILITY", "KAMI_HARV_INTENSITY", "KAMI_HARV_STRAIN", "KAMI_LVL_REQ_BASE", "KAMI_LVL_REQ_MULT_BASE", "KAMI_REST_METABOLISM"], "deployed": true}, "KamiMarketAcceptOffer": {"comment": "@notice Accept any offer \u2014 WETH pulled from buyer, kami reassigned via IDOwnsKami", "args": "uint256